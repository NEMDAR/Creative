# Default Lovable/reference behavior
VITE_NEMDAR_DATA_MODE=mock

# Set to local to use browser-safe NEMDAR API endpoints through the Vite /api proxy.
# Authenticated /api/v1/* endpoints still require an injected server-side transport.
# VITE_NEMDAR_DATA_MODE=local
# VITE_NEMDAR_API_BASE_URL=
# NEMDAR_LOCAL_BACKEND_URL=http://127.0.0.1:3000
