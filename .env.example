# Phase 0/1 works without provider secrets.
# Future server-only values go here. Never expose paid provider secrets with NEXT_PUBLIC_.
NEXT_PUBLIC_APP_NAME=NEMDAR Creative Studio
NEXT_PUBLIC_CANONICAL_URL=https://creative.nemdar.tech

# Server-side render worker. In production install FFmpeg in the container
# and either expose it on PATH or set this path explicitly.
FFMPEG_PATH=
FFMPEG_VIDEO_ENCODER=
FFMPEG_VIDEO_BITRATE=5M
FFMPEG_AUDIO_BITRATE=192k
RENDER_QUEUE_DIR=

# P3 automatic captions. whisper-1 is used because the current transcription
# API exposes segment/word timestamp granularities for that model.
CAPTION_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CAPTION_MODEL=whisper-1
